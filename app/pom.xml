<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example.sportbooking</groupId>
    <artifactId>sportbooking</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  
  <artifactId>app</artifactId>
  <name>app</name> 
  <packaging>jar</packaging>
  
  <dependencies>
  		
        <!-- Dependencias de tus módulos -->
        <dependency>
            <groupId>com.example.sportbooking</groupId>
            <artifactId>user-module</artifactId>
             <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.sportbooking</groupId>
            <artifactId>auth-module</artifactId>
             <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.sportbooking</groupId>
            <artifactId>venue-module</artifactId>
             <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.sportbooking</groupId>
            <artifactId>court-module</artifactId>
             <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.sportbooking</groupId>
            <artifactId>time-block-module</artifactId>
             <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.sportbooking</groupId>
            <artifactId>court-schedule-module</artifactId>
             <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.sportbooking</groupId>
            <artifactId>user-venue-role-module</artifactId>
             <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.sportbooking</groupId>
            <artifactId>reservation-module</artifactId>
             <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- OpenAPI / Swagger UI: banco de pruebas visual del contrato.
             Version 2.x = linea para Spring Boot 3 (springdoc 1.x era para Boot 2). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>
    </dependencies>
  
	<build>
	  <plugins>
	  
	  	<!-- Spring Boot plugin -->
	    <plugin>
	      <groupId>org.springframework.boot</groupId>
	      <artifactId>spring-boot-maven-plugin</artifactId>
	      <configuration>
	        <!-- Correr con cwd = root del repo, asi ./application-local.properties se encuentra siempre -->
	        <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
	      </configuration>
	    </plugin>
	    
	    <plugin>
        	<groupId>org.apache.maven.plugins</groupId>
	        <artifactId>maven-jar-plugin</artifactId>
	        <version>3.2.0</version>
	        <configuration>
	          <!-- Configuración adicional del JAR si es necesario -->
	        </configuration>
      </plugin>
	  </plugins>
	  
	</build>
  
</project>