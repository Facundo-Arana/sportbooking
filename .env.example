# Copiar a .env (no versionado) para sobreescribir los defaults de docker-compose.yml.
# Todos estos valores son SOLO para desarrollo: no usar en produccion.

# Base de datos (servicio db)
POSTGRES_DB=sportbooking
POSTGRES_USER=sportbooking
POSTGRES_PASSWORD=sportbooking

# Conexion de la aplicacion a esa base (deben coincidir con POSTGRES_*)
DB_USERNAME=sportbooking
DB_PASSWORD=sportbooking

# Firma de los JWT (minimo 32 caracteres para HS256)
JWT_SECRET=sportbooking-dev-only-jwt-secret-change-me-1234

# Perfil de Spring: dev siembra los datos de ejemplo
SPRING_PROFILES_ACTIVE=dev

# Origenes permitidos por CORS (frontend de Vite por defecto)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Credenciales del administrador sembrado por el perfil dev
APP_DEV_ADMIN_EMAIL=admin@sportbooking.dev
APP_DEV_ADMIN_PASSWORD=admin123

# Puerto publicado en el host
APP_PORT=8081
