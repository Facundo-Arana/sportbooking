<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example.sportbooking</groupId>
    <artifactId>sportbooking</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>court-schedule-module</artifactId>
  <name>court-schedule-module</name>
  <packaging>jar</packaging>
  <description>Módulo de horarios habilitados por cancha (court schedule)</description>

  <dependencies>
    <!-- CourtSchedule depende de Court Y de TimeBlock: es el primer módulo
         con dos @ManyToOne simultáneos hacia módulos distintos. Reutiliza
         CourtRepository/CourtNotFoundException de court-module y
         TimeBlockRepository/TimeBlockNotFoundException de time-block-module. -->
    <dependency>
      <groupId>com.example.sportbooking</groupId>
      <artifactId>court-module</artifactId>
      <version>0.0.1-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.example.sportbooking</groupId>
      <artifactId>time-block-module</artifactId>
      <version>0.0.1-SNAPSHOT</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <!-- Configuración adicional del JAR si es necesario -->
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
